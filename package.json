{
	"name": "inj-authz",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build:client": "tsc && vite build",
		"build:server": "tsup-node server/index.ts",
		"build": "yarn build:client && yarn build:server",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"lint:biome": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"preview": "vite preview",
		"server": "tsx watch server/index.ts",
		"serve": "tsx dist/out/index.cjs",
		"inj-local": "pnpm add @injectivelabs/networks@link:../injective-ts/packages/networks @injectivelabs/sdk-ts@link:../injective-ts/packages/sdk-ts @injectivelabs/token-metadata@next @injectivelabs/ts-types@link:../injective-ts/packages/ts-types @injectivelabs/utils@link:../injective-ts/packages/utils @injectivelabs/wallet-core@link:../injective-ts/packages/wallets/wallet-core @injectivelabs/wallet-base@link:../injective-ts/packages/wallets/wallet-base",
		"inj-latest": "pnpm add @injectivelabs/networks@latest @injectivelabs/sdk-ts@latest @injectivelabs/token-metadata@latest @injectivelabs/ts-types@latest @injectivelabs/utils@latest @injectivelabs/wallet-core@latest @injectivelabs/wallet-base@latest"
	},
	"dependencies": {
		"@bangjelkoski/vite-plugin-node-polyfills": "^0.0.2",
		"@hono/node-server": "^1.13.1",
		"@injectivelabs/networks": "^1.16.34",
		"@injectivelabs/sdk-ts": "^1.16.34",
		"@injectivelabs/token-metadata": "1.14.11",
		"@injectivelabs/ts-types": "^1.16.34",
		"@injectivelabs/utils": "^1.16.34",
		"@injectivelabs/wallet-base": "^1.16.34",
		"@injectivelabs/wallet-core": "^1.16.34",
		"@injectivelabs/wallet-cosmos": "^1.17.3",
		"@injectivelabs/wallet-evm": "^1.16.34",
		"@injectivelabs/wallet-private-key": "^1.16.34",
		"buffer": "^6.0.3",
		"ethers": "^6.16.0",
		"hono": "4.6.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-qr-code": "^2.0.14",
		"react-select": "^5.8.0",
		"tsup": "^8.1.0",
		"tsup-node": "^0.1.0",
		"uuid": "^10.0.0",
		"viem": "^2.43.5",
		"ws": "^8.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@types/node": "^20.14.2",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@types/uuid": "^9",
		"@types/ws": "^8",
		"@typescript-eslint/eslint-plugin": "^7.13.0",
		"@typescript-eslint/parser": "^7.13.0",
		"@vitejs/plugin-react": "^4.3.1",
		"autoprefixer": "^10.4.19",
		"eslint": "^8.57.0",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-react-refresh": "^0.4.7",
		"helix-mobile-server": "link:../injective-helix-server",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.4",
		"tsx": "^4.15.2",
		"typescript": "^5.4.5",
		"vite": "^5.2.13",
		"vite-plugin-node-polyfills": "^0.23.0"
	}
}
